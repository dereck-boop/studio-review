# ---------------------------------------------------------------
#  Studio Review settings. Copy this file to .env and edit it.
#  Don't use $ or quotes in values.
# ---------------------------------------------------------------

# REQUIRED. Your sign-in password (8+ characters, no $ or quotes).
ADMIN_PASSWORD=change-me-please

# REQUIRED on a server (leave empty to try it on your own computer).
# The web address clients will use, without https://  e.g. review.yourstudio.com
# Point this name's DNS A record at your server before starting.
DOMAIN=

# Name shown in the header (two words look best: "Northside Review").
BRAND=Studio Review

# Your name, shown on the notes you leave.
OWNER_NAME=Engineer

# Optional: phone notifications via the free ntfy app (https://ntfy.sh).
# Pick an unguessable topic name and subscribe to it in the app.
# NTFY_URL=https://ntfy.sh/my-studio-notes-x8k2q9

# Optional: auto-import bounces. In Docker, mount the folder in docker-compose.yml and use /watch.
# WATCH_DIR=/watch

# Advanced: override the address used in share links (defaults to https://DOMAIN).
# PUBLIC_URL=https://review.yourstudio.com
